# Шаблон окружения бэкенда. Скопируй в .env / .env.local (они gitignored) и
# заполни. В проде значения обычно задаются переменными окружения платформы.

# --- Обязательные (без них приложение не стартует) ---
DATABASE_URL=postgresql+psycopg2://<user>:<pass>@<host>:5432/scientific_db
SECRET_KEY=<длинный случайный секрет для подписи JWT; в проде — свой, не из dev>

# --- Cookie / сессии (значения ниже — ПРОД) ---
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=.researcher.uz          # обязателен в проде: cookie должна быть видна и фронту, и API
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Фронт и CORS ---
FRONTEND_URL=https://researcher.uz
CORS_ORIGINS=https://researcher.uz,https://www.researcher.uz

# --- Google OAuth (redirect на БЭКЕНД) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.researcher.uz/auth/google/callback

# --- ORCID OAuth ---
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=https://api.researcher.uz/auth/orcid/callback
ORCID_ENV=production                  # sandbox — для локальной разработки

# --- Zenodo (внешний DOI для статей из формы админки) ---
# Персональный токен zenodo.org → Applications → Personal access tokens
# (scopes deposit:write + deposit:actions). Пусто = кнопка «Публиковать в
# Zenodo» отвечает 503. Только на бэкенде, во фронт не попадает.
ZENODO_TOKEN=

# --- Cloudflare R2 (S3-совместимо) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://<r2-домен-без-слэша>

# --- OpenAlex (цитирования) ---
OPENALEX_MAILTO=info@researcher.uz

# --- Cloudflare Turnstile (антибот на /search и регистрации) ---
# Пустой секрет = проверка выключена (эндпоинты работают как раньше).
# Ключи: dash.cloudflare.com → Turnstile → Add widget (домены researcher.uz,
# www.researcher.uz, localhost). Site key публичный — он в .env фронта
# (NEXT_PUBLIC_TURNSTILE_SITE_KEY), сюда идёт только secret key.
TURNSTILE_SECRET_KEY=
# HUMAN_PASS_EXPIRE_HOURS=12   # сколько живёт cookie-пропуск после проверки

# --- OAI-PMH (выдача метаданных партнёрам: EBSCO, BASE, CORE) ---
# Эндпоинт /oai закрыт ключом из таблицы oai_clients — «выключателя» тут нет:
# нет выданных ключей = никто ничего не заберёт. Ключи: scripts/oai_client.py.
# OAI_BASE_URL=https://api.researcher.uz/oai   # пусто = берём из запроса
# OAI_ADMIN_EMAIL=info@researcher.uz
# OAI_PAGE_SIZE=100         # записей на страницу выдачи
# OAI_RATE_LIMIT=60/minute  # запросов к /oai с одного IP
# OAI_NAMESPACE=researcher.uz   # НЕ менять после первой выдачи наружу:
#                               # харвестер узнаёт записи по oai:<namespace>:...

# --- Только для контейнера (docker-entrypoint.sh) ---
# RUN_MIGRATIONS=1        # прогнать alembic upgrade head на старте (одиночный инстанс)
# WEB_CONCURRENCY=2       # число uvicorn-воркеров

# --- Автопроверка выпуска перед публикацией (issue-review.md) ---
# Главный выключатель и режим: rules | llm | both
ISSUE_REVIEW_ENABLED=true
ISSUE_REVIEW_MODE=both
AI_REVIEW_DELAY_MINUTES=60

# Чья модель сверяет метаданные с PDF: gemini | openrouter | anthropic.
# Пусто — определяется по тому, чей ключ задан.
LLM_PROVIDER=
# Google AI Studio — бесплатный тариф (aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OpenRouter — среди моделей есть бесплатные (суффикс :free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Claude — платный
ANTHROPIC_API_KEY=
AI_REVIEW_MODEL=claude-opus-5

# Уведомления владельцу о проблемных выпусках. Пусто = выключены.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_BASE_URL=https://researcher.uz

# --- Рассылка авторам (scripts/outreach_send.py) ---
# Пусто = скрипт только показывает, кому ушло бы письмо.
RESEND_API_KEY=
# Отдельный поддомен, проверенный в Resend (SPF/DKIM), плюс DMARC.
OUTREACH_FROM="Ism Familiya, researcher.uz <hello@mail.researcher.uz>"
OUTREACH_REPLY_TO=
OUTREACH_SITE_URL=https://researcher.uz
OUTREACH_API_URL=https://api.researcher.uz
